{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mkdocs: build",
            "type": "shell",
            "command": "docker run --rm --volume \"${env:LOCAL_WORKSPACE_FOLDER}:/docs\" --workdir /docs --user \"$(id -u):$(id -g)\" --env INPUT_THEME=material althack/mkdocs-simple-plugin:latest mkdocs_simple_gen --build",
            "problemMatcher": []
        },
        {
            "label": "mkdocs: serve",
            "type": "shell",
            "command": "docker run --rm --publish 8000:8000 --volume \"${env:LOCAL_WORKSPACE_FOLDER}:/docs\" --env INPUT_THEME=material althack/mkdocs-simple-plugin:latest",
            "problemMatcher": []
        }
    ]
}
